<Window x:Class="OniTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OniTool — Onimusha 模型/动作/音频查看器" Height="720" Width="1180"
        Background="#2b2b2b">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" Background="#3c3f41">
            <Button x:Name="BtnOpen" Content="打开目录" Click="BtnOpen_Click" Padding="8,2"/>
            <Separator/>
            <TextBlock x:Name="RootLabel" VerticalAlignment="Center" Foreground="#ddd"
                       Text="(未选择目录)" Margin="6,0"/>
        </ToolBar>

        <Border DockPanel.Dock="Bottom" Background="#333" Padding="6" BorderBrush="#555" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="AudioName" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="#9c9" Width="360" TextTrimming="CharacterEllipsis"
                           Text="音频: (无)"/>
                <Button x:Name="BtnPlay" DockPanel.Dock="Left" Content="播放" Click="BtnPlay_Click" Padding="8,2" Margin="4,0"/>
                <Button x:Name="BtnStop" DockPanel.Dock="Left" Content="停止" Click="BtnStop_Click" Padding="8,2" Margin="0,0,8,0"/>
                <Button x:Name="BtnExportAudio" DockPanel.Dock="Left" Content="导出WAV" Click="BtnExportAudio_Click" Padding="8,2"/>
                <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#aaa"
                           Margin="12,0" TextTrimming="CharacterEllipsis" Text="就绪"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="#252526">
                <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="4"
                         Background="#3c3f41" Foreground="#ddd" BorderBrush="#555"
                         TextChanged="Filter_TextChanged"
                         ToolTip="按名称过滤（下次展开目录时生效）"/>
                <TreeView x:Name="Tree" Background="#252526" Foreground="#ddd"
                          BorderThickness="0" SelectedItemChanged="Tree_SelectedItemChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#555"/>

            <wv2:WebView2 x:Name="Web" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
