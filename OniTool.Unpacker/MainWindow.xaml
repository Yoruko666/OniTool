<Window x:Class="REE.Unpacker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OniTool — PAK 解包器" Height="420" Width="720"
        Background="#2b2b2b">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏根目录" Foreground="#ddd"
                   VerticalAlignment="Center" Margin="0,0,8,6"/>
        <TextBox x:Name="RootBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" Padding="4"
                 Background="#3c3f41" Foreground="#ddd" BorderBrush="#555"/>
        <Button x:Name="BtnRoot" Grid.Row="0" Grid.Column="2" Content="浏览…" Padding="10,2"
                Margin="0,0,0,6" Click="BtnRoot_Click"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="输出目录" Foreground="#ddd"
                   VerticalAlignment="Center" Margin="0,0,8,6"/>
        <TextBox x:Name="OutBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" Padding="4"
                 Background="#3c3f41" Foreground="#ddd" BorderBrush="#555"/>
        <Button x:Name="BtnOut" Grid.Row="1" Grid.Column="2" Content="浏览…" Padding="10,2"
                Margin="0,0,0,6" Click="BtnOut_Click"/>

        <Button x:Name="BtnStart" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                Content="开始解包" Padding="10,4" Margin="0,6" HorizontalAlignment="Right"
                Click="BtnStart_Click"/>

        <ProgressBar x:Name="Bar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                     Height="20" Minimum="0" Maximum="100" Margin="0,6"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   Foreground="#9c9" TextTrimming="CharacterEllipsis" Margin="0,2,0,6" Text="就绪"/>

        <TextBox x:Name="LogBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                 Background="#1e1e1e" Foreground="#bbb" BorderBrush="#555"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
